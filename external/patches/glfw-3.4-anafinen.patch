+static GLFWbool validWindowEdges(int edges)
+{
+    const int vertical = edges & (GLFW_WINDOW_EDGE_TOP | GLFW_WINDOW_EDGE_BOTTOM);
+    const int horizontal = edges & (GLFW_WINDOW_EDGE_LEFT | GLFW_WINDOW_EDGE_RIGHT);
+
+    if (edges == 0 || (edges & ~15))
+        return GLFW_FALSE;
+    if (vertical == (GLFW_WINDOW_EDGE_TOP | GLFW_WINDOW_EDGE_BOTTOM))
+        return GLFW_FALSE;
+    if (horizontal == (GLFW_WINDOW_EDGE_LEFT | GLFW_WINDOW_EDGE_RIGHT))
+        return GLFW_FALSE;
+    return GLFW_TRUE;
+}
