+// ANAFINEN PATCH BEGIN: client-side title bar support
+//
+// _NET_WM_MOVERESIZE directions (EWMH 1.5)
+#define _NET_WM_MOVERESIZE_SIZE_TOPLEFT      0
+#define _NET_WM_MOVERESIZE_SIZE_TOP          1
+#define _NET_WM_MOVERESIZE_SIZE_TOPRIGHT     2
+#define _NET_WM_MOVERESIZE_SIZE_RIGHT        3
+#define _NET_WM_MOVERESIZE_SIZE_BOTTOMRIGHT  4
+#define _NET_WM_MOVERESIZE_SIZE_BOTTOM       5
+#define _NET_WM_MOVERESIZE_SIZE_BOTTOMLEFT   6
+#define _NET_WM_MOVERESIZE_SIZE_LEFT         7
+#define _NET_WM_MOVERESIZE_MOVE              8
+
+// The pointer position on the root window, which the window manager wants with the request
+static GLFWbool queryRootPointer(_GLFWwindow* window, int* rootX, int* rootY)
+{
+    Window root, child;
+    int childX, childY;
+    unsigned int mask;
+
+    return XQueryPointer(_glfw.x11.display, window->x11.handle,
+                         &root, &child, rootX, rootY, &childX, &childY, &mask) ? GLFW_TRUE : GLFW_FALSE;
+}
+
+static void sendMoveResize(_GLFWwindow* window, long direction)
+{
+    int rootX, rootY;
+
+    if (!_glfw.x11.NET_WM_MOVERESIZE)
+    {
+        _glfwInputError(GLFW_FEATURE_UNAVAILABLE,
+                        "X11: The window manager does not support _NET_WM_MOVERESIZE");
+        return;
+    }
+
+    if (!queryRootPointer(window, &rootX, &rootY))
+        return;
+
+    // The window manager takes the pointer grab over; release the implicit grab
+    // of the button press first
+    XUngrabPointer(_glfw.x11.display, CurrentTime);
+
+    XEvent event = { ClientMessage };
+    event.xclient.window = window->x11.handle;
+    event.xclient.format = 32; // Data is 32-bit longs
+    event.xclient.message_type = _glfw.x11.NET_WM_MOVERESIZE;
+    event.xclient.data.l[0] = rootX;
+    event.xclient.data.l[1] = rootY;
+    event.xclient.data.l[2] = direction;
+    event.xclient.data.l[3] = Button1;
+    event.xclient.data.l[4] = 1; // Normal application
+
+    XSendEvent(_glfw.x11.display, _glfw.x11.root, False,
+               SubstructureNotifyMask | SubstructureRedirectMask, &event);
+    XFlush(_glfw.x11.display);
+}
+
+void _glfwDragWindowX11(_GLFWwindow* window)
+{
+    sendMoveResize(window, _NET_WM_MOVERESIZE_MOVE);
+}
+
+void _glfwResizeWindowFromEdgeX11(_GLFWwindow* window, int edges)
+{
+    long direction;
+
+    switch (edges)
+    {
+        case GLFW_WINDOW_EDGE_TOP | GLFW_WINDOW_EDGE_LEFT:
+            direction = _NET_WM_MOVERESIZE_SIZE_TOPLEFT; break;
+        case GLFW_WINDOW_EDGE_TOP:
+            direction = _NET_WM_MOVERESIZE_SIZE_TOP; break;
+        case GLFW_WINDOW_EDGE_TOP | GLFW_WINDOW_EDGE_RIGHT:
+            direction = _NET_WM_MOVERESIZE_SIZE_TOPRIGHT; break;
+        case GLFW_WINDOW_EDGE_RIGHT:
+            direction = _NET_WM_MOVERESIZE_SIZE_RIGHT; break;
+        case GLFW_WINDOW_EDGE_BOTTOM | GLFW_WINDOW_EDGE_RIGHT:
+            direction = _NET_WM_MOVERESIZE_SIZE_BOTTOMRIGHT; break;
+        case GLFW_WINDOW_EDGE_BOTTOM:
+            direction = _NET_WM_MOVERESIZE_SIZE_BOTTOM; break;
+        case GLFW_WINDOW_EDGE_BOTTOM | GLFW_WINDOW_EDGE_LEFT:
+            direction = _NET_WM_MOVERESIZE_SIZE_BOTTOMLEFT; break;
+        case GLFW_WINDOW_EDGE_LEFT:
+            direction = _NET_WM_MOVERESIZE_SIZE_LEFT; break;
+        default:
+            return;
+    }
+
+    sendMoveResize(window, direction);
+}
+
+void _glfwShowWindowMenuX11(_GLFWwindow* window)
+{
+    int rootX, rootY;
+
+    if (!_glfw.x11.GTK_SHOW_WINDOW_MENU)
+    {
+        _glfwInputError(GLFW_FEATURE_UNAVAILABLE,
+                        "X11: The window manager does not support _GTK_SHOW_WINDOW_MENU");
+        return;
+    }
+
+    if (!queryRootPointer(window, &rootX, &rootY))
+        return;
+
+    XUngrabPointer(_glfw.x11.display, CurrentTime);
+
+    XEvent event = { ClientMessage };
+    event.xclient.window = window->x11.handle;
+    event.xclient.format = 32;
+    event.xclient.message_type = _glfw.x11.GTK_SHOW_WINDOW_MENU;
+    event.xclient.data.l[0] = 0; // Core pointer device
+    event.xclient.data.l[1] = rootX;
+    event.xclient.data.l[2] = rootY;
+
+    XSendEvent(_glfw.x11.display, _glfw.x11.root, False,
+               SubstructureNotifyMask | SubstructureRedirectMask, &event);
+    XFlush(_glfw.x11.display);
+}
