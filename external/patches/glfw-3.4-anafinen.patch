+GLFWAPI void glfwDragWindow(GLFWwindow* handle)
+{
+    _GLFWwindow* window = (_GLFWwindow*) handle;
+    assert(window != NULL);
+
+    _GLFW_REQUIRE_INIT();
+
+    if (window->monitor)
+        return;
+
+    switch (_glfw.platform.platformID)
+    {
+#if defined(_GLFW_WIN32)
+        case GLFW_PLATFORM_WIN32:
+            _glfwDragWindowWin32(window);
+            return;
+#endif
+#if defined(_GLFW_X11)
+        case GLFW_PLATFORM_X11:
+            _glfwDragWindowX11(window);
+            return;
+#endif
+#if defined(_GLFW_WAYLAND)
+        case GLFW_PLATFORM_WAYLAND:
+            _glfwDragWindowWayland(window);
+            return;
+#endif
+        default:
+            _glfwInputError(GLFW_FEATURE_UNAVAILABLE,
+                            "Window dragging is not available on this platform");
+            return;
+    }
+}
+
+GLFWAPI void glfwResizeWindowFromEdge(GLFWwindow* handle, int edges)
+{
+    _GLFWwindow* window = (_GLFWwindow*) handle;
+    assert(window != NULL);
+
+    _GLFW_REQUIRE_INIT();
+
+    if (!validWindowEdges(edges))
+    {
+        _glfwInputError(GLFW_INVALID_ENUM, "Invalid window edges 0x%x", edges);
+        return;
+    }
+
+    if (window->monitor || !window->resizable)
+        return;
+
+    switch (_glfw.platform.platformID)
+    {
+#if defined(_GLFW_WIN32)
+        case GLFW_PLATFORM_WIN32:
+            _glfwResizeWindowFromEdgeWin32(window, edges);
+            return;
+#endif
+#if defined(_GLFW_X11)
+        case GLFW_PLATFORM_X11:
+            _glfwResizeWindowFromEdgeX11(window, edges);
+            return;
+#endif
+#if defined(_GLFW_WAYLAND)
+        case GLFW_PLATFORM_WAYLAND:
+            _glfwResizeWindowFromEdgeWayland(window, edges);
+            return;
+#endif
+        default:
+            _glfwInputError(GLFW_FEATURE_UNAVAILABLE,
+                            "Window edge resizing is not available on this platform");
+            return;
+    }
+}
