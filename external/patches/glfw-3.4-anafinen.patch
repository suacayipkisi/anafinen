+// ANAFINEN PATCH BEGIN: client-side title bar support
+//
+// The non-client mouse-down starts the system's own modal move / size loop, so
+// Aero Snap and the move / size animations behave as with a native title bar.
+static void startNonClientDrag(_GLFWwindow* window, WPARAM hitTest)
+{
+    POINT pos;
+    if (!GetCursorPos(&pos))
+        return;
+
+    ReleaseCapture();
+    SendMessageW(window->win32.handle, WM_NCLBUTTONDOWN, hitTest, MAKELPARAM(pos.x, pos.y));
+}
+
+void _glfwDragWindowWin32(_GLFWwindow* window)
+{
+    startNonClientDrag(window, HTCAPTION);
+}
+
+void _glfwResizeWindowFromEdgeWin32(_GLFWwindow* window, int edges)
+{
+    WPARAM hitTest;
+
+    switch (edges)
+    {
+        case GLFW_WINDOW_EDGE_TOP | GLFW_WINDOW_EDGE_LEFT:     hitTest = HTTOPLEFT; break;
+        case GLFW_WINDOW_EDGE_TOP:                             hitTest = HTTOP; break;
+        case GLFW_WINDOW_EDGE_TOP | GLFW_WINDOW_EDGE_RIGHT:    hitTest = HTTOPRIGHT; break;
+        case GLFW_WINDOW_EDGE_RIGHT:                           hitTest = HTRIGHT; break;
+        case GLFW_WINDOW_EDGE_BOTTOM | GLFW_WINDOW_EDGE_RIGHT: hitTest = HTBOTTOMRIGHT; break;
+        case GLFW_WINDOW_EDGE_BOTTOM:                          hitTest = HTBOTTOM; break;
+        case GLFW_WINDOW_EDGE_BOTTOM | GLFW_WINDOW_EDGE_LEFT:  hitTest = HTBOTTOMLEFT; break;
+        case GLFW_WINDOW_EDGE_LEFT:                            hitTest = HTLEFT; break;
+        default: return;
+    }
+
+    startNonClientDrag(window, hitTest);
+}
