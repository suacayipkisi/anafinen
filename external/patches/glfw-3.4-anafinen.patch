+// ANAFINEN PATCH BEGIN: client-side title bar support
+//
+// libdecor owns the xdg_toplevel when it is in use; the request goes to the same
+// object libdecor itself would use for its own title bar.
+static struct xdg_toplevel* getXdgToplevel(_GLFWwindow* window)
+{
+    if (window->wl.libdecor.frame)
+        return libdecor_frame_get_xdg_toplevel(window->wl.libdecor.frame);
+
+    return window->wl.xdg.toplevel;
+}
+
+static GLFWbool canStartPointerGrab(_GLFWwindow* window, struct xdg_toplevel** toplevel)
+{
+    *toplevel = getXdgToplevel(window);
+    if (!*toplevel || !_glfw.wl.seat)
+    {
+        _glfwInputError(GLFW_PLATFORM_ERROR,
+                        "Wayland: The window has no toplevel or there is no seat");
+        return GLFW_FALSE;
+    }
+
+    if (_glfw.wl.pointerFocus != window || _glfw.wl.pointerButtonSerial == 0)
+    {
+        _glfwInputError(GLFW_PLATFORM_ERROR,
+                        "Wayland: Window move / resize needs a button press on the window");
+        return GLFW_FALSE;
+    }
+
+    return GLFW_TRUE;
+}
+
+void _glfwDragWindowWayland(_GLFWwindow* window)
+{
+    struct xdg_toplevel* toplevel;
+    if (!canStartPointerGrab(window, &toplevel))
+        return;
+
+    xdg_toplevel_move(toplevel, _glfw.wl.seat, _glfw.wl.pointerButtonSerial);
+    wl_display_flush(_glfw.wl.display);
+}
+
+void _glfwResizeWindowFromEdgeWayland(_GLFWwindow* window, int edges)
+{
+    struct xdg_toplevel* toplevel;
+    if (!canStartPointerGrab(window, &toplevel))
+        return;
+
+    // GLFW_WINDOW_EDGE_* use the xdg_toplevel.resize_edge values
+    xdg_toplevel_resize(toplevel, _glfw.wl.seat, _glfw.wl.pointerButtonSerial, (uint32_t) edges);
+    wl_display_flush(_glfw.wl.display);
+}
+
+void _glfwShowWindowMenuWayland(_GLFWwindow* window)
+{
+    struct xdg_toplevel* toplevel;
+    if (!canStartPointerGrab(window, &toplevel))
+        return;
+
+    xdg_toplevel_show_window_menu(toplevel, _glfw.wl.seat, _glfw.wl.pointerButtonSerial,
+                                  (int32_t) window->wl.cursorPosX,
+                                  (int32_t) window->wl.cursorPosY);
+    wl_display_flush(_glfw.wl.display);
+}
