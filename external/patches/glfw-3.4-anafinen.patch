+void _glfwShowWindowMenuWin32(_GLFWwindow* window)
+{
+    HWND handle = window->win32.handle;
+    HMENU menu = GetSystemMenu(handle, FALSE);
+    POINT pos;
+    const BOOL maximized = IsZoomed(handle);
+    UINT command;
+
+    if (!menu || !GetCursorPos(&pos))
+        return;
+
+    // The entries follow the window state, as in the menu of a native title bar
+    EnableMenuItem(menu, SC_RESTORE, MF_BYCOMMAND | (maximized ? MF_ENABLED : MF_GRAYED));
+    EnableMenuItem(menu, SC_MOVE, MF_BYCOMMAND | (maximized ? MF_GRAYED : MF_ENABLED));
+    EnableMenuItem(menu, SC_SIZE, MF_BYCOMMAND |
+                   ((maximized || !window->resizable) ? MF_GRAYED : MF_ENABLED));
+    EnableMenuItem(menu, SC_MINIMIZE, MF_BYCOMMAND | MF_ENABLED);
+    EnableMenuItem(menu, SC_MAXIMIZE, MF_BYCOMMAND |
+                   ((maximized || !window->resizable) ? MF_GRAYED : MF_ENABLED));
+    SetMenuDefaultItem(menu, SC_CLOSE, FALSE);
+
+    command = (UINT) TrackPopupMenu(menu, TPM_RETURNCMD | TPM_RIGHTBUTTON | TPM_NONOTIFY,
+                                    pos.x, pos.y, 0, handle, NULL);
+    if (command)
+        PostMessageW(handle, WM_SYSCOMMAND, command, 0);
+}
